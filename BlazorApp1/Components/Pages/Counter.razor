@page "/counter"
@using Auth0.ManagementApi
@using Auth0.ManagementApi.Models
@using Microsoft.AspNetCore.Authorization
@inject IManagementApiClient _managementApiClient
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Usuarios</PageTitle>

<h1>Usuarios</h1>

<RadzenDataGrid 
    AllowFiltering="true" 
    AllowColumnResize="true" 
    AllowAlternatingRows="false" 
    FilterMode="FilterMode.Advanced" 
    AllowSorting="true" PageSize="5" 
    AllowPaging="true" 
    PagerHorizontalAlign="HorizontalAlign.Left" 
    ShowPagingSummary="true"
    Data="@users" 
    ColumnWidth="300px" 
    LogicalFilterOperator="LogicalFilterOperator.Or" 
    SelectionMode="DataGridSelectionMode.Single" 
    @bind-Value=@selectedUsers>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(UserItemList.UserId)" Filterable="false" Title="ID" Frozen="true" Width="80px" TextAlign="TextAlign.Center" />
        <RadzenDataGridColumn Title="Photo" Frozen="true" Sortable="false" Filterable="false" Width="80px" TextAlign="TextAlign.Center" >
            <Template Context="data">
                <RadzenImage Path="@data.Picture" class="rz-gravatar" AlternateText="@(data.FullName)" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(UserItemList.FullName)" Title="First Name" Frozen="true" Width="160px" />
        <RadzenDataGridColumn Property="@nameof(UserItemList.Email)" Title="Last Name" Width="160px"/>
    </Columns>
</RadzenDataGrid>

@code {
    IEnumerable<UserItemList> users = new List<UserItemList>();
    IList<UserItemList> selectedUsers;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
 
        //users = dbContext.users;
        var request = new GetUsersRequest();
        var model = await _managementApiClient.Users.GetAllAsync(request);

        users = model.Select(s => new UserItemList()
        {
            UserId = s.UserId,
            Picture = s.Picture,
            FullName = s.FullName,
            Email = s.Email
        });

        //selectedusers = new List<Employee>(){ users.FirstOrDefault() };
    }
    
    public class UserItemList
    {
        public string UserId { get; set; }
        public string FullName { get; set; }
        public string Picture { get; set; }
        public string Email { get; set; }
    }
}